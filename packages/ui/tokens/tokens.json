{
  "$description": "Personal design system light foundations. DTCG 2025.10 format.",
  "color": {
    "primitive": {
      "green": {
        "50": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9137, 0.9569, 0.9412], "alpha": 1, "hex": "#E9F4F0" } },
        "600": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4627, 0.4314], "alpha": 1, "hex": "#0F766E" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0392, 0.3608, 0.3333], "alpha": 1, "hex": "#0A5C55" } }
      },
      "neutral": {
        "white": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#FFFFFF" } },
        "canvas": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9804, 0.9765], "alpha": 1, "hex": "#F8FAF9" } },
        "ink": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0902, 0.1373, 0.1216], "alpha": 1, "hex": "#17231F" } },
        "secondary": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.2706, 0.3294, 0.298], "alpha": 1, "hex": "#45544C" } },
        "border": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.8627, 0.8941, 0.8706], "alpha": 1, "hex": "#DCE4DE" } },
        "control": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.4431, 0.5176, 0.4784], "alpha": 1, "hex": "#71847A" } }
      },
      "red": { "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.7059, 0.1373, 0.0941], "alpha": 1, "hex": "#B42318" } } }
    },
    "surface": {
      "canvas": { "$type": "color", "$value": "{color.primitive.neutral.canvas}" },
      "default": { "$type": "color", "$value": "{color.primitive.neutral.white}" },
      "accentSubtle": { "$type": "color", "$value": "{color.primitive.green.50}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.primitive.neutral.ink}" },
      "secondary": { "$type": "color", "$value": "{color.primitive.neutral.secondary}" },
      "onAccent": { "$type": "color", "$value": "{color.primitive.neutral.white}" },
      "accent": { "$type": "color", "$value": "{color.primitive.green.700}" },
      "error": { "$type": "color", "$value": "{color.primitive.red.700}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "{color.primitive.neutral.border}" },
      "control": { "$type": "color", "$value": "{color.primitive.neutral.control}" },
      "error": { "$type": "color", "$value": "{color.primitive.red.700}" }
    },
    "action": {
      "default": { "$type": "color", "$value": "{color.primitive.green.600}" },
      "hover": { "$type": "color", "$value": "{color.primitive.green.700}" }
    },
    "focus": { "ring": { "$type": "color", "$value": "{color.primitive.green.700}" } }
  },
  "space": {
    "micro": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
  },
  "font": { "family": { "base": { "$type": "fontFamily", "$value": "Pretendard Variable" } } },
  "duration": {
    "fast": { "$type": "duration", "$value": { "value": 0.15, "unit": "s" } },
    "normal": { "$type": "duration", "$value": { "value": 0.2, "unit": "s" } },
    "spinner": { "$type": "duration", "$value": { "value": 0.7, "unit": "s" } }
  },
  "size": {
    "control": {
      "sm": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "md": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
      "touch": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
    },
    "checkbox": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "badge": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "textareaMin": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } },
    "spinner": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
  },
  "typography": {
    "size": {
      "caption": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "bodySm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "body": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "headingSm": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "headingMd": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "headingLg": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "display": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } }
    },
    "lineHeight": {
      "caption": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "bodySm": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "body": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "headingSm": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "headingMd": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "headingLg": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "display": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
    },
    "weight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 500 },
      "semibold": { "$type": "number", "$value": 600 },
      "bold": { "$type": "number", "$value": 700 }
    }
  },
  "stroke": {
    "default": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
    "strong": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
  },
  "focusIndicator": {
    "width": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "offset": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": 0.55 },
    "disabledInput": { "$type": "number", "$value": 0.75 }
  }
}
